# Copy this file to .env and fill in YOUR values. Never commit .env. Names only here, no secrets.

# --- Module 5: read-only user (views only) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=portfolio_web
DB_PASSWORD=
DB_NAME=future_portfolio_db

# --- Module 7: the writer user (least privilege) ---
DB_WRITE_USER=portfolio_writer
DB_WRITE_PASSWORD=

# --- Module 8: the owner's key (python -c "import secrets; print(secrets.token_urlsafe(32))") ---
OWNER_API_KEY=
# Exact origins allowed to call the API from a browser (no trailing slash, no path, never *)
CORS_ORIGINS=http://127.0.0.1:5500,https://your-username.github.io
# Fine-grained token: Public repositories (read-only), 30 days
GITHUB_TOKEN=
GITHUB_USER=
